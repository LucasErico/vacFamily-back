# ============================================================
# VacFamily Back-end — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
# URL do front-end para CORS (separar por vírgula se houver mais de uma)
FRONT_URL=http://localhost:5173

# --- Supabase ---
# Project URL (visível no painel: Settings → API)
SUPABASE_URL=https://kffcdtmgylzfllqhsikq.supabase.co

# Chave pública (anon) — usada pelo front-end
# SUPABASE_ANON_KEY=sb_publishable_...

# Chave secreta (service_role) — usada APENAS pelo back-end
# Nunca exponha esta chave no front-end
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# JWKS URL para validação de tokens Supabase Auth
SUPABASE_JWKS_URL=https://kffcdtmgylzfllqhsikq.supabase.co/auth/v1/.well-known/jwks.json

# --- JWT (tokens internos da API) ---
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria_minimo_32_chars
JWT_EXPIRES_IN=7d

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=10

# --- E-mail (SMTP para verificação e recuperação de senha) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM="VacFamily <noreply@vacfamily.app>"

# --- IA Assistente (Groq) ---
GROQ_API_KEY=sua_groq_api_key
GROQ_MODEL=llama3-8b-8192
